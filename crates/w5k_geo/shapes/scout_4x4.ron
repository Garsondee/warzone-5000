// Parametric scout 4x4: a fictional light reconnaissance car in the proportions of the jeep and Land-Rover class (lane GEOMETRY). One shell,
// everything else anchored to it (see utility_4x4.ron for the conventions: fractions of the hull box, x of W from the centre line, y of H from
// the underside, z of L from the front; `_m` sizes are metres; `Upper`/`Lower`/`Top`/`Belt`/`Front`/`Rear` are surface anchors). Provenance
// ESTIMATE for every number, bands +-15% for fractions and +-50% for the small absolute sizes, reason: an original design, not a copy of a
// real vehicle. It is open: the shell is a low deck with a raised hood and a thin, steeply raked windscreen slab, and the tub's walls, the
// seats and the roll bar stand on it, so the silhouette from the side and above is a low runabout, nothing like the utility truck's cab.
(
    body: (
        // (z, lower half-width, belt height, upper half-width, top height, tilt, underside): the lines plan of the shell.
        stations: [
            (z: 0.020, w: 0.84, yb: 0.40, wu: 0.60, yt: 0.46, yo: 0.20),            // nose face, underside raised (approach ramp)
            (z: 0.035, w: 0.95, yb: 0.40, wu: 0.68, yt: 0.50, yo: 0.09),
            (z: 0.050, w: 1.00, yb: 0.40, wu: 0.74, yt: 0.52, yo: 0.02),            // full width as the arch begins
            (z: 0.075, w: 1.00, yb: 0.40, wu: 0.78, yt: 0.535),
            (z: 0.290, w: 1.00, yb: 0.40, wu: 0.82, yt: 0.55),                      // hood meets the cowl
            (z: 0.300, w: 1.00, yb: 0.40, wu: 0.96, yt: 0.55),                      // the cowl widens to the tub
            (z: 0.318, w: 1.00, yb: 0.40, wu: 0.96, yt: 0.84),                      // windscreen top: a ramp of about 80 degrees
            (z: 0.326, w: 1.00, yb: 0.40, wu: 0.96, yt: 0.84),                      // the windscreen slab is 3 cm thick
            (z: 0.328, w: 1.00, yb: 0.40, wu: 0.96, yt: 0.46),                      // behind it the tub floor
            (z: 0.945, w: 1.00, yb: 0.40, wu: 0.96, yt: 0.46),
            (z: 0.955, w: 0.98, yb: 0.39, wu: 0.94, yt: 0.46, yo: 0.05),            // departure ramp
            (z: 0.9675, w: 0.94, yb: 0.385, wu: 0.90, yt: 0.455, yo: 0.14),         // tail face
        ],
        lip_proud_m: 0.03,
        lower_chamfer_m: 0.03,
        sill_chamfer_m: 0.06,
        upper_chamfer_m: 0.04,
        arch_gap_m: 0.04,
        well_gap_m: 0.04,
        arch_samples: 12,
        min_wall_m: 0.08,
        min_notch_m: 0.002,
    ),
    parts: [
        // ---- arch lips, bumpers
        (name: "arch_lip", role: Hull, slot: Paint, fitting: false, mirror: false, shape: ArchLip(inner_m: -0.01, width_m: 0.07, embed_m: 0.02, proud_m: 0.03, corner_m: 0.012)),
        (name: "bumper_front", role: Hull, slot: Metal, fitting: false, mirror: false, shape: Block(x: Frac(-0.46, 0.46), y: Frac(0.11, 0.21), z: Frac(0.0, 0.04), corner_m: 0.015)),
        (name: "bumper_rear", role: Hull, slot: Metal, fitting: false, mirror: false, shape: Block(x: Frac(-0.46, 0.46), y: Frac(0.11, 0.21), z: Frac(0.96, 1.0), corner_m: 0.015)),
        // ---- the hood and the windscreen
        (name: "hood_panel", role: Hull, slot: Paint, fitting: true, mirror: false, shape: Overlay(z: (0.055, 0.295), inset_m: 0.06, embed_m: 0.015, proud_m: 0.005, corner_m: 0.006)),
        (name: "windscreen", role: Hull, slot: Glass, fitting: true, mirror: false, shape: Windscreen(from_f: 0.30, to_f: 0.318, margin_m: 0.04, inset_m: 0.07, thickness_m: 0.014, proud_m: 0.003, corner_m: 0.02, bezel: Some(Bezel(width_m: 0.03, proud_m: 0.012)))),
        // ---- the open tub: walls, the dash, seats, the roll bar
        (name: "coaming", role: Hull, slot: Paint, fitting: true, mirror: true, shape: Block(x: Upper(-0.07, 0.0), y: Top(-0.01, 0.17), z: Frac(0.335, 0.955), corner_m: 0.012)),
        (name: "tail_panel", role: Hull, slot: Paint, fitting: true, mirror: false, shape: Block(x: Frac(-0.46, 0.46), y: Top(-0.01, 0.17), z: Rear(-0.07, 0.0), corner_m: 0.012)),
        (name: "dash", role: Hull, slot: Paint, fitting: true, mirror: false, shape: Block(x: Frac(-0.40, 0.40), y: Top(-0.01, 0.20), z: Frac(0.328, 0.352), corner_m: 0.012)),
        (name: "seat", role: Hull, slot: Canvas, fitting: true, mirror: true, shape: Block(x: Frac(0.04, 0.26), y: Top(-0.02, 0.12), z: Frac(0.42, 0.50), corner_m: 0.02)),
        (name: "seat_back", role: Hull, slot: Canvas, fitting: true, mirror: true, shape: Block(x: Frac(0.04, 0.26), y: Top(0.08, 0.52), z: Frac(0.495, 0.515), corner_m: 0.02)),
        (name: "bench", role: Hull, slot: Canvas, fitting: true, mirror: false, shape: Block(x: Frac(-0.30, 0.30), y: Top(-0.02, 0.12), z: Frac(0.70, 0.78), corner_m: 0.02)),
        (name: "bench_back", role: Hull, slot: Canvas, fitting: true, mirror: false, shape: Block(x: Frac(-0.30, 0.30), y: Top(0.08, 0.45), z: Frac(0.775, 0.795), corner_m: 0.02)),
        // the roll bar is structure, not a fitting: it is the highest part of the box (floor 0.46 H, bar top at H = 0.54 H above the floor)
        (name: "rollbar_post", role: Hull, slot: Metal, fitting: false, mirror: true, shape: Cyl(axis: Y, x: Frac(0.40, 0.40), y: Top(-0.02, 0.815), z: Frac(0.60, 0.60), radius_m: 0.022)),
        (name: "rollbar_top", role: Hull, slot: Metal, fitting: false, mirror: false, shape: Cyl(axis: X, x: Frac(-0.40, 0.40), y: Top(0.815, 0.815), z: Frac(0.60, 0.60), radius_m: 0.022)),
        // ---- fittings
        (name: "headlamp", role: Hull, slot: Optics, fitting: true, mirror: true, shape: Cyl(axis: Z, x: Frac(0.26, 0.31), y: Frac(0.40, 0.45), z: Front(-0.04, 0.025), radius_m: 0.06)),
        (name: "grille", role: Hull, slot: Metal, fitting: true, mirror: false, shape: Block(x: Frac(-0.12, 0.12), y: Frac(0.27, 0.40), z: Front(-0.04, 0.025), corner_m: 0.008)),
        (name: "spare_wheel", role: Hull, slot: Rubber, fitting: true, mirror: false, shape: Cyl(axis: Z, x: Frac(0.0, 0.0), y: Frac(0.54, 0.54), z: Rear(-0.05, 0.17), radius_m: 0.30)),
        (name: "antenna", role: Hull, slot: Metal, fitting: true, mirror: false, shape: Cyl(axis: Y, x: Frac(-0.40, -0.40), y: Top(-0.03, 1.05), z: Frac(0.93, 0.93), radius_m: 0.006)),
    ],
    knuckle_radius_m: 0.06,
    sockets: [],
)
