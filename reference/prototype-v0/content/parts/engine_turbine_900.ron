#![enable(implicit_some)]
// 900 kW gas turbine: about twice the power of the diesel for less weight, at the cost of fuel (later).
// Part space origin at the base; the turbine axis runs along Z, 0.42 m up.
(
    id: "engine_turbine_900",
    name: "900 kW turbine",
    category: Engine,
    size: Large,
    tags: ["engine", "turbine"],
    shapes: [
        Cylinder(radius: 0.34, length: 1.2, axis: Z, segments: 12, at: (0, 0.42, 0), mat: "machinery", slot: Metal, chamfer: 0.02),
        Cylinder(radius: 0.42, length: 0.22, axis: Z, segments: 12, taper: 0.8, at: (0, 0.42, -0.7), mat: "machinery", slot: Dark, chamfer: 0.02),
        Cylinder(radius: 0.28, length: 0.22, axis: Z, segments: 12, at: (0, 0.42, 0.7), mat: "machinery", slot: Dark),
        Box(size: (0.5, 0.25, 0.8), at: (0, 0.125, 0), mat: "machinery", slot: Dark, chamfer: 0.02),
    ],
    sockets: [
        (name: "mount", kind: Mount, size: Large, at: (0, 0, 0), normal: (0, -1, 0)),
    ],
    function: (power_kw: 900),
)
