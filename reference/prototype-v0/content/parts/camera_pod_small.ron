#![enable(implicit_some)]
// Gimballed camera ball. Hangs below its mount.
(
    id: "camera_pod_small",
    name: "Camera pod",
    category: Sensor,
    size: Tiny,
    tags: ["sensor", "optical"],
    shapes: [
        Box(size: (0.06, 0.04, 0.04), at: (0, -0.02, 0), mat: "composite", slot: Dark, chamfer: 0.005),
        Sphere(radius: 0.045, segments: 10, at: (0, -0.07, 0), mat: "electronics", slot: Secondary),
        Cylinder(radius: 0.02, length: 0.02, axis: Z, segments: 10, at: (0, -0.07, -0.043), mat: "glass", slot: Glass),
    ],
    sockets: [
        (name: "mount", kind: Mount, size: Tiny, at: (0, 0, 0), normal: (0, 1, 0)),
    ],
    function: (sensor_m: 400, draw_kw: 0.02),
)
