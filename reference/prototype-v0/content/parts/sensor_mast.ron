#![enable(implicit_some)]
// Sensor mast: a radar dish and an optical head 2.5 m up. Height is range: the higher the sensor, the
// farther its horizon (see docs/design/01-technical-architecture.md, vision).
(
    id: "sensor_mast",
    name: "Sensor mast",
    category: Sensor,
    size: Medium,
    tags: ["sensor", "radar", "optical"],
    shapes: [
        Cylinder(radius: 0.25, length: 0.15, segments: 10, at: (0, 0.075, 0), mat: "machinery", slot: Dark, chamfer: 0.02),
        Cylinder(radius: 0.07, length: 2.2, segments: 8, taper: 0.7, at: (0, 1.25, 0), slot: Secondary),
        // Optical head.
        Box(size: (0.35, 0.22, 0.3), at: (0, 2.3, 0.22), mat: "electronics", slot: Primary, chamfer: 0.03),
        Cylinder(radius: 0.06, length: 0.05, axis: Z, segments: 10, at: (0, 2.3, 0.05), mat: "glass", slot: Glass),
        // Radar dish (a shallow frustum) and its feed horn.
        Cylinder(radius: 0.55, length: 0.12, axis: Z, segments: 14, taper: 0.55, at: (0, 2.55, 0.1), rot: (-12, 0, 0), mat: "electronics", slot: Metal, chamfer: 0.01),
        Cylinder(radius: 0.025, length: 0.42, axis: Z, segments: 6, at: (0, 2.6, -0.15), rot: (-12, 0, 0), mat: "fittings", slot: Dark),
        Sphere(radius: 0.05, segments: 8, at: (0, 2.95, 0.15), mat: "glass", slot: Glow),
    ],
    sockets: [
        (name: "mount", kind: Mount, size: Medium, at: (0, 0, 0), normal: (0, -1, 0)),
    ],
    function: (sensor_m: 1500, draw_kw: 8),
)
