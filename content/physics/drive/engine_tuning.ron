// Engine controller settings shared by every engine (idle controller, rev-limiter fade). Not properties of one engine: of the model.
EngineTuning(
    idle_kp_per_rad_s: Param(v: 0.02, lo: Some(0.005), hi: Some(0.1), prov: Estimate, src: "idle controller gain, throttle per rad/s of speed error; loop-gain judgement, stable for J 0.1-2 kg m^2"),
    idle_ki_per_rad: Param(v: 0.05, lo: Some(0.01), hi: Some(0.3), prov: Estimate, src: "idle controller integral gain, throttle per rad of accumulated error"),
    rev_fade_fraction: Param(v: 0.03, lo: Some(0.01), hi: Some(0.08), prov: Estimate, src: "torque fades to zero over the last fraction of the redline speed (governor droop of a few percent)"),
    bsfc_best_load_fraction: Param(v: 0.75, lo: Some(0.6), hi: Some(0.9), prov: Estimate, src: "diesel and petrol engines are most efficient at high load, about three quarters of full-load torque"),
    bsfc_best_speed_fraction: Param(v: 0.5, lo: Some(0.3), hi: Some(0.7), prov: Estimate, src: "best-efficiency speed is in the middle of the idle-to-redline range, near peak torque"),
    bsfc_load_penalty: Param(v: 1.0, lo: Some(0.3), hi: Some(3.0), prov: Estimate, src: "quadratic rise of specific consumption away from the best load; part-load consumption is up to ~1.5-2x the best figure at light load"),
    bsfc_speed_penalty: Param(v: 0.6, lo: Some(0.2), hi: Some(2.0), prov: Estimate, src: "quadratic rise of specific consumption away from the best speed (friction at high rpm, pumping at low)"),
)
