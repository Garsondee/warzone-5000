#![enable(implicit_some)]
// Numerical regularisation shared by every chassis (not properties of one vehicle). Units are in the field names.
ChassisTuning(
    friction_smoothing_m_s: Param(v: 0.01, lo: 0.002, hi: 0.05, prov: Estimate,
        src: "tanh ramp of dry strut friction; small enough to look like Coulomb at 0.1 m/s, wide enough that a 300 Hz step does not chatter"),
    min_gas_volume_frac: Param(v: 0.05, lo: 0.02, hi: 0.2, prov: Estimate,
        src: "numerical floor for the polytropic gas volume; a hydropneumatic strut never reaches 5% of its rest volume before the hard stop"),
    rolling_fade_speed_m_s: Param(v: 0.2, lo: 0.05, hi: 0.5, prov: Estimate,
        src: "speed over which rolling resistance fades to zero at standstill (tanh scale), so a parked truck is not pushed backwards; PROVISIONAL(CCR-chassis-1)"),
    slip_damping_time_s: Param(v: 0.005, lo: 0.001, hi: 0.02, prov: Estimate,
        src: "damping on the rate of tyre patch stretch, as a fraction of the stretch stiffness; 5 ms gives a stopped 2.5 t truck a damping ratio of about 0.05 on its tyres"),
)
