#![enable(implicit_some)]
// A tank body on legs: a Bastion hull walking on six stilts, with a gun in one turret and a missile rack in the other.
(
    id: "mech_bastion", name: "Mech Bastion", hull: "hull_bastion",
    hull_params: { "length_m": 9.0, "width_m": 3.4, "height_m": 2.0, "front_mm": 80, "side_mm": 40, "turrets": 2, "stations": 3, "sponson": 0.6 },
    palette: "verdant",
    attach: [
        (socket: "station_*", family: "legs", params: { "stance_m": 3.2, "bend": 0.35 }),
        (socket: "engine", family: "engine", params: { "power_kw": 1500, "tech": 1 }),
        (socket: "turret_1", family: "turret_gun", params: { "calibre_mm": 105, "barrel_cal": 50, "armour_mm": 70, "slope": 0.5, "loader": 1, "ammo": 36 }),
        (socket: "turret_2", family: "turret_missile", params: { "tube_mm": 130, "tubes": 8, "armour_mm": 15, "seeker": 0.8, "warhead": 0.3, "elevation": 35 }, spin: 180),
        (socket: "mast_1", family: "sensor", params: { "height_m": 1.5, "aperture_m": 0.4, "radar": 0.4 }),
    ],
)
