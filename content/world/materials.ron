#![enable(implicit_some)]
// Surfaces of the bump strip and (until the cited soil table lands, build step 2) of every course.
// Ids are list positions: 0 asphalt, 1 dirt, 2 mud: the same ids and numbers as the contract stand-ins, so nothing changes under CHASSIS.
// UNVALIDATED: every number here is the stand-in order of magnitude; WORLD asks VALIDATION to source them (docs/swarm/requests).
[
    MaterialDef(
        name: "asphalt",
        mu_peak: Param(v: 0.9, lo: 0.7, hi: 1.0, prov: Estimate, src: "UNVALIDATED stand-in; dry asphalt, typical tyre-road peak friction"),
        mu_slide: Param(v: 0.8, lo: 0.6, hi: 0.9, prov: Estimate, src: "UNVALIDATED stand-in"),
        rolling_coeff: Param(v: 0.0, lo: 0.0, hi: 0.005, prov: Estimate, src: "UNVALIDATED stand-in; the tyre's own coefficient already covers a hard surface"),
        roughness_rms_m: Param(v: 0.002, lo: 0.001, hi: 0.005, prov: Estimate, src: "UNVALIDATED stand-in"),
    ),
    MaterialDef(
        name: "dirt",
        mu_peak: Param(v: 0.65, lo: 0.5, hi: 0.8, prov: Estimate, src: "UNVALIDATED stand-in; firm dirt road"),
        mu_slide: Param(v: 0.55, lo: 0.4, hi: 0.7, prov: Estimate, src: "UNVALIDATED stand-in"),
        rolling_coeff: Param(v: 0.025, lo: 0.015, hi: 0.04, prov: Estimate, src: "UNVALIDATED stand-in"),
        roughness_rms_m: Param(v: 0.015, lo: 0.005, hi: 0.03, prov: Estimate, src: "UNVALIDATED stand-in"),
    ),
    MaterialDef(
        name: "mud",
        mu_peak: Param(v: 0.45, lo: 0.3, hi: 0.6, prov: Estimate, src: "UNVALIDATED stand-in; wet clay order of magnitude"),
        mu_slide: Param(v: 0.4, lo: 0.3, hi: 0.5, prov: Estimate, src: "UNVALIDATED stand-in"),
        rolling_coeff: Param(v: 0.0, lo: 0.0, hi: 0.01, prov: Estimate, src: "the soil law supplies the compaction resistance"),
        roughness_rms_m: Param(v: 0.03, lo: 0.01, hi: 0.06, prov: Estimate, src: "UNVALIDATED stand-in"),
        soil: Some(SoilDef(
            // The clay row of the Bekker-Wong soil parameter set, as reproduced in Table 2 of arXiv:2603.28965 (Koopman operator
            // framework for off-road vehicles on deformable terrain; sandy loam and clay). A SECONDARY source: Wong's book itself has not
            // been opened by this project, so the original page and table are still to be verified (VALIDATION); the units are kN
            // converted to N here (kc 13.19 kN/m^(n+1), kphi 692.15 kN/m^(n+2), c 4.14 kPa, phi 0.2269 rad = 13 degrees).
            n: Param(v: 0.5, lo: 0.3, hi: 0.7, prov: Spec, src: "arXiv:2603.28965 Table 2, clay row (secondary reproduction of the Bekker-Wong set; primary to verify)"),
            kc_pa_m_n1: Param(v: 13190.0, lo: 10000.0, hi: 15000.0, prov: Spec, src: "arXiv:2603.28965 Table 2, clay row, 13.19 kN/m^(n+1) (secondary; primary to verify)"),
            kphi_pa_m_n: Param(v: 692150.0, lo: 600000.0, hi: 800000.0, prov: Spec, src: "arXiv:2603.28965 Table 2, clay row, 692.15 kN/m^(n+2) (secondary; primary to verify)"),
            cohesion_pa: Param(v: 4140.0, lo: 3000.0, hi: 6000.0, prov: Spec, src: "arXiv:2603.28965 Table 2, clay row, 4.14 kPa (secondary; primary to verify)"),
            friction_angle_deg: Param(v: 13.0, lo: 10.0, hi: 16.0, prov: Spec, src: "arXiv:2603.28965 Table 2, clay row, 0.2269 rad (secondary; primary to verify)"),
            shear_k_m: Param(v: 0.01, lo: 0.005, hi: 0.02, prov: Spec, src: "arXiv:2603.28965 Table 2, clay row, 0.01 m (secondary; primary to verify)"),
        )),
    ),
    MaterialDef(
        name: "gravel",
        mu_peak: Param(v: 0.6, lo: 0.4, hi: 0.75, prov: Estimate, src: "UNVALIDATED stand-in; loose stone and gravel, between dirt and mud"),
        mu_slide: Param(v: 0.5, lo: 0.35, hi: 0.65, prov: Estimate, src: "UNVALIDATED stand-in"),
        rolling_coeff: Param(v: 0.06, lo: 0.03, hi: 0.1, prov: Estimate, src: "UNVALIDATED stand-in; loose surfaces cost more than firm dirt"),
        roughness_rms_m: Param(v: 0.06, lo: 0.03, hi: 0.12, prov: Estimate, src: "UNVALIDATED stand-in; stones the 1 m grid does not resolve"),
    ),
    MaterialDef(
        name: "riverbed",
        mu_peak: Param(v: 0.5, lo: 0.3, hi: 0.7, prov: Estimate, src: "UNVALIDATED stand-in; submerged gravel and silt"),
        mu_slide: Param(v: 0.4, lo: 0.25, hi: 0.6, prov: Estimate, src: "UNVALIDATED stand-in"),
        rolling_coeff: Param(v: 0.08, lo: 0.04, hi: 0.15, prov: Estimate, src: "UNVALIDATED stand-in; the water's own drag is the water model's job, not this number"),
        roughness_rms_m: Param(v: 0.05, lo: 0.02, hi: 0.1, prov: Estimate, src: "UNVALIDATED stand-in"),
    ),
    MaterialDef(
        name: "planks",
        mu_peak: Param(v: 0.5, lo: 0.3, hi: 0.7, prov: Estimate, src: "UNVALIDATED stand-in; weathered wooden decking, slick when wet"),
        mu_slide: Param(v: 0.4, lo: 0.25, hi: 0.6, prov: Estimate, src: "UNVALIDATED stand-in"),
        rolling_coeff: Param(v: 0.02, lo: 0.01, hi: 0.05, prov: Estimate, src: "UNVALIDATED stand-in"),
        roughness_rms_m: Param(v: 0.02, lo: 0.01, hi: 0.05, prov: Estimate, src: "UNVALIDATED stand-in; gaps and cupped boards"),
    ),
    MaterialDef(
        name: "sand",
        mu_peak: Param(v: 0.55, lo: 0.4, hi: 0.7, prov: Estimate, src: "UNVALIDATED; tyre or shoe friction on dry sand, order of magnitude; VALIDATION to source"),
        mu_slide: Param(v: 0.5, lo: 0.35, hi: 0.65, prov: Estimate, src: "UNVALIDATED"),
        rolling_coeff: Param(v: 0.0, lo: 0.0, hi: 0.01, prov: Estimate, src: "the soil law supplies the compaction resistance"),
        roughness_rms_m: Param(v: 0.02, lo: 0.01, hi: 0.05, prov: Estimate, src: "UNVALIDATED; ripples the 1 m grid does not resolve"),
        soil: Some(SoilDef(
            n: Param(v: 1.1, lo: 0.7, hi: 1.3, prov: Estimate, src: "UNVALIDATED; the dry-sand class of the Bekker-Wong tables in Wong, Theory of Ground Vehicles (values as widely reproduced; VALIDATION to verify table and page)"),
            kc_pa_m_n1: Param(v: 990.0, lo: 100.0, hi: 3000.0, prov: Estimate, src: "UNVALIDATED; dry-sand class, N/m^(n+1) (0.99 kN/m^(n+1) as widely reproduced)"),
            kphi_pa_m_n: Param(v: 1528430.0, lo: 800000.0, hi: 2500000.0, prov: Estimate, src: "UNVALIDATED; dry-sand class, N/m^(n+2) (1528 kN/m^(n+2) as widely reproduced)"),
            cohesion_pa: Param(v: 1040.0, lo: 0.0, hi: 2000.0, prov: Estimate, src: "UNVALIDATED; dry-sand class (about 1 kPa)"),
            friction_angle_deg: Param(v: 28.0, lo: 25.0, hi: 35.0, prov: Estimate, src: "UNVALIDATED; dry-sand class"),
            shear_k_m: Param(v: 0.025, lo: 0.01, hi: 0.04, prov: Estimate, src: "UNVALIDATED; dry-sand class"),
        )),
    ),
    MaterialDef(
        name: "sandy_loam",
        mu_peak: Param(v: 0.6, lo: 0.4, hi: 0.75, prov: Estimate, src: "UNVALIDATED stand-in; tyre friction on sandy loam, order of magnitude"),
        mu_slide: Param(v: 0.5, lo: 0.35, hi: 0.65, prov: Estimate, src: "UNVALIDATED stand-in"),
        rolling_coeff: Param(v: 0.0, lo: 0.0, hi: 0.01, prov: Estimate, src: "the soil law supplies the compaction resistance"),
        roughness_rms_m: Param(v: 0.02, lo: 0.01, hi: 0.05, prov: Estimate, src: "UNVALIDATED stand-in"),
        soil: Some(SoilDef(
            // The sandy-loam row of the same set (arXiv:2603.28965 Table 2): kc 5.27 kN/m^(n+1), kphi 1515.04 kN/m^(n+2), c 1.72 kPa,
            // phi 0.5061 rad = 29 degrees, K 0.025 m. Secondary source; primary to verify.
            n: Param(v: 0.7, lo: 0.5, hi: 0.9, prov: Spec, src: "arXiv:2603.28965 Table 2, sandy loam row (secondary; primary to verify)"),
            kc_pa_m_n1: Param(v: 5270.0, lo: 4000.0, hi: 7000.0, prov: Spec, src: "arXiv:2603.28965 Table 2, sandy loam row, 5.27 kN/m^(n+1) (secondary; primary to verify)"),
            kphi_pa_m_n: Param(v: 1515040.0, lo: 1200000.0, hi: 1800000.0, prov: Spec, src: "arXiv:2603.28965 Table 2, sandy loam row, 1515.04 kN/m^(n+2) (secondary; primary to verify)"),
            cohesion_pa: Param(v: 1720.0, lo: 1000.0, hi: 3000.0, prov: Spec, src: "arXiv:2603.28965 Table 2, sandy loam row, 1.72 kPa (secondary; primary to verify)"),
            friction_angle_deg: Param(v: 29.0, lo: 25.0, hi: 33.0, prov: Spec, src: "arXiv:2603.28965 Table 2, sandy loam row, 0.5061 rad (secondary; primary to verify)"),
            shear_k_m: Param(v: 0.025, lo: 0.01, hi: 0.04, prov: Spec, src: "arXiv:2603.28965 Table 2, sandy loam row, 0.025 m (secondary; primary to verify)"),
        )),
    ),
]
