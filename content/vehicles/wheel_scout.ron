#![enable(implicit_some)]
// Fitted by `w5k fit` from wheel_scout.ron: running gear and engine sized to the vehicle.
(
    id: "wheel_scout",
    name: "Wheel Scout",
    hull: "hull_lancer",
    hull_params: {
        "front_mm": 12.0,
        "glacis": 0.6,
        "height_m": 0.8,
        "length_m": 5.0,
        "nose": 0.7,
        "side_mm": 8.0,
        "stations": 3.0,
        "width_m": 2.0,
    },
    palette: Some("verdant"),
    attach: [(
        socket: "station_*",
        family: Some("wheel"),
        params: {
            "diameter_m": 1.1,
            "pressure_kpa": 300.0,
            "tread": 0.8,
            "width_m": 0.15,
        },
    ), (
        socket: "engine",
        family: Some("engine"),
        params: {
            "power_kw": 84.12,
            "tech": 1.0,
        },
    ), (
        socket: "turret",
        family: Some("turret_gun"),
        params: {
            "ammo": 100.0,
            "armour_mm": 10.0,
            "barrel_cal": 40.0,
            "calibre_mm": 30.0,
            "loader": 1.0,
            "slope": 0.4,
        },
    ), (
        socket: "mast_1",
        family: Some("sensor"),
        params: {
            "aperture_m": 0.3,
            "height_m": 3.0,
            "radar": 0.1,
        },
    )],
)