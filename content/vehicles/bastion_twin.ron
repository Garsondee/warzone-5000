#![enable(implicit_some)]
// Bastion with two turrets: a fast-firing 30 mm autocannon forward and a 105 mm gun aft.
(
    id: "bastion_twin",
    name: "Bastion Twin",
    hull: "hull_bastion",
    hull_params: { "length_m": 8.0, "width_m": 2.9, "height_m": 1.9, "front_mm": 80, "side_mm": 40, "turrets": 2, "sponson": 0.7 },
    palette: "vanguard",
    attach: [
        (socket: "track_r", family: "track", params: { "width_m": 0.7, "wheels": 7, "skirt_mm": 20 }),
        (socket: "track_l", family: "track", params: { "width_m": 0.7, "wheels": 7, "skirt_mm": 20 }, mirror: true),
        (socket: "engine", family: "engine", params: { "power_kw": 900, "tech": 1 }),
        (socket: "turret_1", family: "turret_gun", params: { "calibre_mm": 30, "barrel_cal": 60, "armour_mm": 40, "slope": 0.5, "loader": 0.6, "ammo": 300 }),
        (socket: "turret_2", family: "turret_gun", params: { "calibre_mm": 105, "barrel_cal": 50, "armour_mm": 90, "slope": 0.6, "loader": 0, "ammo": 30 }),
    ],
)
