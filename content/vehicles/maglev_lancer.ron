#![enable(implicit_some)]
// Fitted by `w5k fit` from maglev_lancer.ron: running gear and engine sized to the vehicle.
(
    id: "maglev_lancer",
    name: "Maglev Lancer",
    hull: "hull_lancer",
    hull_params: {
        "front_mm": 60.0,
        "height_m": 1.1,
        "length_m": 8.0,
        "side_mm": 25.0,
        "stations": 2.0,
        "width_m": 2.8,
    },
    palette: Some("vanguard"),
    attach: [(
        socket: "station_*",
        family: Some("antigrav"),
        params: {
            "kw_per_t": 25.0,
            "lift_t": 7.185,
            "ride_m": 2.0,
        },
    ), (
        socket: "engine",
        family: Some("engine"),
        params: {
            "power_kw": 1057.0,
            "tech": 2.0,
        },
    ), (
        socket: "turret",
        family: Some("turret_beam"),
        params: {
            "aperture_m": 0.5,
            "armour_mm": 30.0,
            "power_mw": 8.0,
        },
    ), (
        socket: "mast_1",
        family: Some("sensor"),
        params: {
            "aperture_m": 0.4,
            "height_m": 1.0,
            "radar": 0.5,
        },
    )],
)