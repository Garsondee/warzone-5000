// Materials and colour palettes.
//
// density:  kg per cubic metre (real-world values).
// hardness: protection per metre of thickness relative to rolled homogeneous armour steel (RHA = 1.0).
// armour:   false for materials that do not protect what is behind them (guns, engines, electronics):
//           a shot that hits them damages them instead. Defaults to true.
//           A 50 mm plate of a material with hardness 0.5 protects like 25 mm of steel.
//           Mass efficiency (protection per kg) is hardness / (density / 7850).
(
    materials: {
        // strength_mpa: working strength for load-bearing structures (legs, masts); modulus_gpa: stiffness (buckling).
        "steel":       (density: 7850, hardness: 1.0,  strength_mpa: 350, modulus_gpa: 200),  // structural / rolled homogeneous armour
        "hard_steel":  (density: 7850, hardness: 1.25, strength_mpa: 700, modulus_gpa: 200),  // high-hardness plate: same weight, more protection
        "aluminium":   (density: 2700, hardness: 0.33, strength_mpa: 240, modulus_gpa: 70),   // light hulls: thick, weak per mm, about steel per kg
        "titanium":    (density: 4500, hardness: 0.8,  strength_mpa: 800, modulus_gpa: 110),  // expensive: 1.4x steel per kg
        "ceramic":     (density: 3900, hardness: 1.6,  strength_mpa: 300, modulus_gpa: 370),  // composite inserts: 3.2x steel per kg, brittle later
        "composite":   (density: 1800, hardness: 0.3,  strength_mpa: 550, modulus_gpa: 90),   // airframes, drone bodies, long light legs
        "rubber":      (density: 1100, hardness: 0.02),  // tyres, track pads
        "glass":       (density: 2500, hardness: 0.15),  // optics and canopies
        "machinery":   (density: 1600, hardness: 0.2, armour: false),  // engines, gearboxes: a filled engine bay
        "electronics": (density: 1500, hardness: 0.05, armour: false), // sensor heads, radar dishes
        "gun_steel":   (density: 7850, hardness: 1.0, armour: false),  // barrels and breeches: hits damage the gun
        // Homogenised materials: a volume that stands for a mix of parts and air, so chunky shapes weigh what
        // the real thing would.
        "running_gear": (density: 900, hardness: 0.12),  // track pods: links, wheels, suspension and air
        "fittings":    (density: 600, hardness: 0.05),   // stowage, fenders, lights and other detail
        // Not part of the vehicle: rails and sleepers drawn under a train. No mass, no armour, no bounds.
        "scenery":     (density: 0, hardness: 0, armour: false),
    },
    // Faction palettes. Each follows a 60-30-10 structure: Primary is the dominant body colour (about 60% of the
    // surface), Secondary a darker colour from a neighbouring hue (about 30%), Trim a complementary accent used
    // sparingly (about 10%) for markings, and Glow a high-energy emissive hue. Darks are tinted toward the faction
    // hue rather than neutral grey. Values are spaced so units read at a distance by value, before hue.
    // See docs/design/06-art-direction.md.
    palettes: {
        // Cobalt body, orange markings (blue's complement), electric cyan energy.
        "vanguard": (colours: {
            Primary: "#2f6ee0", Secondary: "#1b2b5e", Trim: "#ff8a24", Dark: "#121628",
            Metal: "#9aa6bc", Rubber: "#191c27", Glow: "#45efff", Glass: "#173d6e",
        }),
        // Crimson body, gold markings, acid-lime energy (red's near complement).
        "crimson": (colours: {
            Primary: "#c9302a", Secondary: "#4c1426", Trim: "#ffcf55", Dark: "#1d0f15",
            Metal: "#ab9e98", Rubber: "#1e1517", Glow: "#b5ff36", Glass: "#3d1a2b",
        }),
        // Teal body, magenta markings (green's complement), lemon energy.
        "verdant": (colours: {
            Primary: "#16a88a", Secondary: "#0e3a40", Trim: "#ff3b98", Dark: "#0c1a1d",
            Metal: "#93a9a5", Rubber: "#131c1d", Glow: "#fff056", Glass: "#103f4b",
        }),
        // Violet body, yellow markings (violet's complement), hot-pink energy.
        "ultraviolet": (colours: {
            Primary: "#6b45ea", Secondary: "#22154f", Trim: "#ffd646", Dark: "#140e25",
            Metal: "#a49fbb", Rubber: "#18152a", Glow: "#ff4bd0", Glass: "#2a185e",
        }),
        "default": (colours: {
            Primary: "#2f6ee0", Secondary: "#1b2b5e", Trim: "#ff8a24", Dark: "#121628",
            Metal: "#9aa6bc", Rubber: "#191c27", Glow: "#45efff", Glass: "#173d6e",
        }),
        // Older, muted palettes kept for comparison.
        "olive": (colours: {
            Primary: "#6f7752", Secondary: "#4d5539", Trim: "#c2a04a", Dark: "#2a2c2d",
            Metal: "#70757b", Rubber: "#1f1f21", Glow: "#5ad8ff", Glass: "#2c4652",
        }),
        "desert": (colours: {
            Primary: "#b39a6c", Secondary: "#8a7451", Trim: "#5c4f3a", Dark: "#2e2a25",
            Metal: "#8c8a86", Rubber: "#1f1e1d", Glow: "#ffb347", Glass: "#3a4a50",
        }),
    },
)
