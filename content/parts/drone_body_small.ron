#![enable(implicit_some)]
// Small quadrotor body: a composite shell with the battery slung underneath. The battery is the power source.
(
    id: "drone_body_small",
    name: "Small drone body",
    category: Hull,
    size: Tiny,
    tags: ["air", "drone"],
    shapes: [
        Sphere(radius: 0.18, segments: 10, scale: (1.0, 0.45, 1.3), mat: "composite", shell: 0.004, chamfer: 0.004),
        // Canopy over the flight computer.
        Sphere(radius: 0.08, segments: 8, scale: (1.0, 0.6, 1.4), at: (0, 0.055, -0.1), mat: "composite", slot: Glass, shell: 0.003),
        // Battery pack and its straps.
        Box(size: (0.14, 0.05, 0.22), at: (0, -0.085, 0.02), mat: "electronics", slot: Dark, chamfer: 0.008),
        Array(count: 2, step: (0, 0, 0.12), children: [
            Box(size: (0.15, 0.054, 0.02), at: (0, -0.085, -0.04), mat: "fittings", slot: Trim),
        ]),
        // Landing skids.
        Mirror(children: [
            Box(size: (0.012, 0.012, 0.34), at: (0.12, -0.15, 0), mat: "composite", slot: Dark),
            Box(size: (0.012, 0.08, 0.012), at: (0.12, -0.11, -0.1), mat: "composite", slot: Dark),
            Box(size: (0.012, 0.08, 0.012), at: (0.12, -0.11, 0.1), mat: "composite", slot: Dark),
        ]),
    ],
    sockets: [
        (name: "rotor_fr", kind: Locomotion, size: Tiny, at: (0.12, 0.0, -0.15), normal: (0.7071, 0, -0.7071), forward: (0, 1, 0)),
        (name: "rotor_fl", kind: Locomotion, size: Tiny, at: (-0.12, 0.0, -0.15), normal: (-0.7071, 0, -0.7071), forward: (0, 1, 0)),
        (name: "rotor_rr", kind: Locomotion, size: Tiny, at: (0.12, 0.0, 0.15), normal: (0.7071, 0, 0.7071), forward: (0, 1, 0)),
        (name: "rotor_rl", kind: Locomotion, size: Tiny, at: (-0.12, 0.0, 0.15), normal: (-0.7071, 0, 0.7071), forward: (0, 1, 0)),
        (name: "chin", kind: Hardpoint, size: Tiny, at: (0, -0.06, -0.2), normal: (0, -1, 0)),
    ],
    function: (power_kw: 2.5),
)
