#![enable(implicit_some)]
// 75 mm cannon with mantlet. Part space: origin at the back of the mantlet; the barrel points along -Z.
(
    id: "cannon_75",
    name: "75 mm cannon",
    category: Weapon,
    size: Medium,
    tags: ["kinetic", "direct", "calibre_75"],
    shapes: [
        Box(size: (0.75, 0.55, 0.3), at: (0, 0, -0.12), mat: "hard_steel", chamfer: 0.05),
        Cylinder(radius: 0.2, length: 0.35, axis: Z, taper: 1.15, at: (0, 0, -0.42), slot: Secondary, chamfer: 0.02),
        // Barrel: radius 65 mm at the muzzle, 85 mm at the breech end (taper scales the +Z end).
        Cylinder(radius: 0.065, length: 3.6, axis: Z, segments: 10, taper: 1.3, at: (0, 0, -2.35)),
        Cylinder(radius: 0.11, length: 0.45, axis: Z, segments: 10, at: (0, 0, -1.9), slot: Secondary, chamfer: 0.015),
        Box(size: (0.26, 0.2, 0.3), at: (0, 0, -4.25), slot: Dark, chamfer: 0.03),
        // Coaxial machine gun.
        Cylinder(radius: 0.025, length: 0.35, axis: Z, segments: 6, at: (0.25, -0.05, -0.42), slot: Dark),
    ],
    sockets: [
        (name: "mount", kind: Mount, size: Medium, at: (0, 0, 0), normal: (0, 0, 1), forward: (0, 1, 0)),
    ],
    function: (draw_kw: 5),
)
