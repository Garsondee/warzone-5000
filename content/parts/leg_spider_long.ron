#![enable(implicit_some)]
// Long spider leg in its rest pose. Part space: hip at the origin, the leg reaches out along +X in the XY
// plane (the plane the leg's IK will work in). Knee at (2.6, 2.0), foot at (5.05, -3.4): the foot is 5 m out
// and 3.4 m below the hip. Segments are hollow steel box sections.
(
    id: "leg_spider_long",
    name: "Long spider leg",
    category: Leg,
    size: Large,
    tags: ["legs", "walker"],
    shapes: [
        // Hip actuator.
        Sphere(radius: 0.28, segments: 10, at: (0.15, 0, 0), mat: "machinery", slot: Dark),
        // Femur: hip to knee, tapering box section (width across the leg plane, height in it).
        Beam(from: (0.2, 0, 0), to: (2.6, 2.0, 0), size: (0.32, 0.36), end: (0.24, 0.26), shell: 0.025, chamfer: 0.03),
        // Hydraulic ram along the top of the femur.
        Beam(from: (0.18, 0.26, 0), to: (1.54, 1.36, 0), size: (0.09, 0.07), end: (0.08, 0.06), mat: "machinery", slot: Metal),
        // Knee actuator.
        Sphere(radius: 0.2, segments: 10, at: (2.6, 2.0, 0), mat: "machinery", slot: Dark),
        // Tibia: knee down to the ankle.
        Beam(from: (2.6, 2.0, 0), to: (5.0, -3.1, 0), size: (0.22, 0.26), end: (0.12, 0.12), shell: 0.02, chamfer: 0.025, slot: Secondary),
        // Warning stripe near the knee: a thin shell, so its inside merges with the hollow tibia.
        Beam(from: (2.77, 1.638, 0), to: (2.856, 1.457, 0), size: (0.235, 0.275), end: (0.234, 0.272), mat: "fittings", slot: Trim, shell: 0.004),
        // Ankle and foot pad.
        Sphere(radius: 0.11, segments: 8, at: (5.02, -3.18, 0), mat: "machinery", slot: Dark),
        Cylinder(radius: 0.2, length: 0.1, segments: 8, taper: 0.7, at: (5.05, -3.35, 0), mat: "rubber", slot: Rubber, chamfer: 0.015),
    ],
    sockets: [
        (name: "mount", kind: Mount, size: Large, at: (0, 0, 0), normal: (-1, 0, 0), forward: (0, 1, 0)),
    ],
    function: (locomotion: Legs, load_kg: 6000, rolling: 0.12, draw_kw: 10, max_kmh: 35),
)
