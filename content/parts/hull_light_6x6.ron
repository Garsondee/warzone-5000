#![enable(implicit_some)]
// Light wheeled hull (6x6): aluminium armour, front engine bay, troop compartment with a rear door.
// Vehicle space: ground at y = 0; the body runs from 0.8 m to 1.85 m, 6 m long and 2.3 m wide.
(
    id: "hull_light_6x6",
    name: "Light 6x6 hull",
    category: Hull,
    size: Medium,
    tags: ["wheeled", "ground"],
    shapes: [
        // Body: sloped nose, sides leaning in toward the roof.
        Hull(
            points: [
                (-1.15, 0.8, 2.9), (-1.0, 1.85, 2.9), (-1.0, 1.85, -1.4), (-1.0, 1.35, -3.0), (-1.15, 1.0, -3.0), (-1.15, 0.8, -2.4),
                ( 1.15, 0.8, 2.9), ( 1.0, 1.85, 2.9), ( 1.0, 1.85, -1.4), ( 1.0, 1.35, -3.0), ( 1.15, 1.0, -3.0), ( 1.15, 0.8, -2.4),
            ],
