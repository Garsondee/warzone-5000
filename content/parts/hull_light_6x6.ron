            Box(size: (0.18, 0.1, 0.06), at: (0.82, 1.2, -3.01), mat: "fittings", slot: Glow),
        ]),
        Box(size: (0.7, 0.14, 0.05), at: (0, 1.7, -1.75), rot: (-17, 0, 0), mat: "glass", slot: Glass),
        // Engine grille on the nose.
        Array(count: 4, step: (0, 0, 0.22), children: [
            Box(size: (1.2, 0.04, 0.09), at: (0, 1.86, -1.05), mat: "fittings", slot: Dark),
