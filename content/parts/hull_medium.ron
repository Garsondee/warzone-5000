#![enable(implicit_some)]
// Medium tracked hull. Vehicle space: +Y up, forward -Z, right +X; the ground is y = 0.
// Body 2.2 m wide, 6.4 m long, 1.0 m tall, riding 0.45 m above the ground. Track units bolt on each side.
(
    id: "hull_medium",
    name: "Medium hull",
    category: Hull,
    size: Medium,
    tags: ["tracked", "ground"],
    shapes: [
        // Main body, side profile (z, y): sloped upper glacis (75 deg from vertical), steeper lower glacis,
        // slight rear overhang. Extruded across x = +-1.1.
        Hull(
            points: [
                (-1.1, 0.45, 3.0), (-1.1, 1.45, 3.2), (-1.1, 1.45, -1.5), (-1.1, 1.0, -3.2), (-1.1, 0.9, -3.2), (-1.1, 0.45, -2.5),
                ( 1.1, 0.45, 3.0), ( 1.1, 1.45, 3.2), ( 1.1, 1.45, -1.5), ( 1.1, 1.0, -3.2), ( 1.1, 0.9, -3.2), ( 1.1, 0.45, -2.5),
            ],
            shell: 0.05, chamfer: 0.035,
        ),
        // Fenders over the tracks.
        Mirror(children: [
            Box(size: (0.66, 0.04, 5.9), at: (1.42, 1.12, 0.05), mat: "fittings", slot: Secondary, chamfer: 0.012),
            // Stowage bins on the fenders.
            Box(size: (0.5, 0.3, 1.1), at: (1.42, 1.29, 1.6), mat: "fittings", slot: Secondary, chamfer: 0.03),
            Box(size: (0.5, 0.24, 0.7), at: (1.42, 1.26, -0.6), mat: "fittings", slot: Secondary, chamfer: 0.03),
            // Headlights on the glacis.
            Cylinder(radius: 0.07, length: 0.12, axis: Z, segments: 8, at: (0.82, 1.06, -3.14), mat: "fittings", slot: Glow, chamfer: 0.01),
            // Tow hooks.
            Box(size: (0.14, 0.14, 0.16), at: (0.75, 0.7, 3.1), mat: "fittings", slot: Dark, chamfer: 0.02),
            // Exhaust.
            Cylinder(radius: 0.09, length: 0.3, axis: Z, segments: 8, at: (0.65, 1.3, 3.25), mat: "fittings", slot: Dark),
        ]),
        // Engine deck with grille slats.
        Box(size: (1.8, 0.1, 1.6), at: (0, 1.5, 2.25), mat: "fittings", slot: Secondary, chamfer: 0.03),
        Array(count: 6, step: (0, 0, 0.24), children: [
            Box(size: (1.6, 0.05, 0.1), at: (0, 1.57, 1.65), mat: "fittings", slot: Dark),
        ]),
        // Driver's hatch and vision block.
        Cylinder(radius: 0.28, length: 0.08, segments: 10, at: (-0.55, 1.48, -1.1), mat: "fittings", slot: Secondary, chamfer: 0.015),
        Box(size: (0.34, 0.07, 0.09), at: (-0.55, 1.5, -1.42), mat: "glass", slot: Glass),
    ],
    sockets: [
        (name: "turret", kind: TurretRing, size: Medium, at: (0, 1.45, 0.1), normal: (0, 1, 0)),
        (name: "track_r", kind: Locomotion, size: Medium, at: (1.1, 0.7, 0.1), normal: (1, 0, 0)),
        (name: "track_l", kind: Locomotion, size: Medium, at: (-1.1, 0.7, 0.1), normal: (-1, 0, 0)),
        (name: "engine", kind: Internal, size: Medium, at: (0, 0.5, 2.0), normal: (0, 1, 0)),
    ],
)
