// M998 HMMWV dossier (calibration set). Every web figure is Secondary/UNVERIFIED: seen only in search summaries, pages not opened
// (docs/lanes/validation/spike-s9.md). Conversions from inches, pounds, mph, hp, gallons and miles are exact. Nothing is from memory.
Dossier(
    id: "m998",
    name: "M998 HMMWV cargo/troop carrier",
    role: Calibration,
    era: "1985-",
    game_id: None,
    quantities: [
        Quantity(id: "static.length_m", category: Static, unit: "m", evidence: Secondary,
            param: Param(v: 4.572, prov: Spec, src: "UNVERIFIED(search summary, page not opened): GlobalSecurity M998 specs page (globalsecurity.org/military/systems/ground/m998-specs.htm): 180 in"),
            notes: ""),
        Quantity(id: "static.width_m", category: Static, unit: "m", evidence: Secondary,
            param: Param(v: 2.159, prov: Spec, src: "UNVERIFIED(search summary, page not opened): GlobalSecurity M998 specs page (globalsecurity.org/military/systems/ground/m998-specs.htm): 85 in"),
            notes: ""),
        Quantity(id: "static.height_m", category: Static, unit: "m", evidence: Secondary,
            param: Param(v: 1.7907, lo: Some(1.7526), hi: Some(1.8288), prov: Spec, src: "UNVERIFIED(search summary, page not opened): GlobalSecurity M998 specs page (globalsecurity.org/military/systems/ground/m998-specs.htm) 69 in; second page 6 ft (72 in)"),
            notes: "Two pages disagree; band covers both."),
        Quantity(id: "static.wheelbase_m", category: Static, unit: "m", evidence: Secondary,
            param: Param(v: 3.302, prov: Spec, src: "UNVERIFIED(search summary, page not opened): GlobalSecurity HMMWV page (globalsecurity.org/military/systems/ground/hmmwv-specs.htm): 130 in (10 ft 10 in)"),
            notes: "Chrono HMMWV model uses 3.378 m (2% longer): cross-check only."),
        Quantity(id: "static.ground_clearance_m", category: Static, unit: "m", evidence: Secondary,
            param: Param(v: 0.4064, lo: Some(0.4064), hi: Some(0.4318), prov: Spec, src: "UNVERIFIED(search summary, page not opened): GlobalSecurity HMMWV page (globalsecurity.org/military/systems/ground/hmmwv-specs.htm) 16 in under axle; AM General brochure 17.0 in for a related model"),
            notes: ""),
        Quantity(id: "static.mass_curb_kg", category: Static, unit: "kg", evidence: Secondary,
            param: Param(v: 2358.680324, lo: Some(2358.680324), hi: Some(3492.661249), prov: Spec, src: "UNVERIFIED(search summary, page not opened): GlobalSecurity HMMWV page (globalsecurity.org/military/systems/ground/hmmwv-specs.htm): tare 5,200 lb; one page lists 7,700 lb as curb weight"),
            notes: "7,700 lb is most likely the gross weight; band keeps the conflict visible. Say which loading when scoring."),
        Quantity(id: "static.mass_gross_kg", category: Static, unit: "kg", evidence: Secondary,
            param: Param(v: 3492.661249, prov: Spec, src: "UNVERIFIED(search summary, page not opened): GlobalSecurity HMMWV page (globalsecurity.org/military/systems/ground/hmmwv-specs.htm): gross 7,700 lb"),
            notes: ""),
        Quantity(id: "powertrain.engine_displacement_m3", category: Powertrain, unit: "m3", evidence: Secondary,
            param: Param(v: 0.0062, lo: Some(0.0062), hi: Some(0.0065), prov: Spec, src: "UNVERIFIED(search summary, page not opened): 6.2 L early M998, a GlobalSecurity page lists 6.5 L"),
            notes: ""),
        Quantity(id: "powertrain.rated_power_w", category: Powertrain, unit: "W", evidence: Secondary,
            param: Param(v: 111854.980737, lo: Some(106262.2317), hi: Some(117447.729774), prov: Spec, src: "UNVERIFIED(search summary, page not opened): two sources about 150 hp at 3,600 rpm, dealer listing about 150 hp (historynet.com/m998-humvee, globalsecurity m998-specs)"),
            notes: "Band is +-5% because summaries say about."),
        Quantity(id: "powertrain.rated_power_speed_rad_s", category: Powertrain, unit: "rad/s", evidence: Secondary,
            param: Param(v: 376.991118, prov: Spec, src: "UNVERIFIED(search summary, page not opened): 3,600 rpm"),
            notes: ""),
        Quantity(id: "powertrain.peak_torque_nm", category: Powertrain, unit: "N m", evidence: Secondary,
            param: Param(v: 338.954487, lo: Some(325.396308), hi: Some(338.954487), prov: Spec, src: "UNVERIFIED(search summary, page not opened): dealer listing about 250 lb-ft (streetsideclassics.com M998 listings); 240 lb-ft not found"),
            notes: "Only the 250 figure was seen; lower end of band is a judgement."),
        Quantity(id: "powertrain.gear_count", category: Powertrain, unit: "1", evidence: Secondary,
            param: Param(v: 3, prov: Spec, src: "UNVERIFIED(search summary, page not opened): early M998 3-speed automatic (allisons.org HMMWV page)"),
            notes: "Gear ratios not found; they are an ESTIMATE for FORGE/DRIVE."),
        Quantity(id: "powertrain.fuel_capacity_m3", category: Powertrain, unit: "m3", evidence: Secondary,
            param: Param(v: 0.094635, prov: Spec, src: "UNVERIFIED(search summary, page not opened): historynet.com/m998-humvee, globalsecurity: 25 gal"),
            notes: ""),
        Quantity(id: "powertrain.range_m", category: Powertrain, unit: "m", evidence: Secondary,
            param: Param(v: 563270.4, prov: Spec, src: "UNVERIFIED(search summary, page not opened): about 350 mi highway"),
            notes: ""),
        Quantity(id: "powertrain.top_speed_m_s", category: Powertrain, unit: "m/s", evidence: Secondary,
            param: Param(v: 24.5872, lo: Some(24.5872), hi: Some(31.2928), prov: Spec, src: "UNVERIFIED(search summary, page not opened): 55 mph governed at gross weight; another page 70 mph maximum highway"),
            notes: "Governor setting and loading differ; band covers both."),
        Quantity(id: "mobility.max_grade_ratio", category: Mobility, unit: "1", evidence: Secondary,
            param: Param(v: 0.6, prov: Spec, src: "UNVERIFIED(search summary, page not opened): GlobalSecurity HMMWV page (globalsecurity.org/military/systems/ground/hmmwv-specs.htm): 60% grade"),
            notes: "Rise over run; 60% is 31.0 degrees. A rating, so scored as a bracket."),
        Quantity(id: "mobility.max_side_slope_ratio", category: Mobility, unit: "1", evidence: Secondary,
            param: Param(v: 0.4, prov: Spec, src: "UNVERIFIED(search summary, page not opened): 40% side slope, fully loaded"),
            notes: ""),
        Quantity(id: "mobility.fording_depth_m", category: Mobility, unit: "m", evidence: Secondary,
            param: Param(v: 0.762, prov: Spec, src: "UNVERIFIED(search summary, page not opened): 30 in without kit"),
            notes: ""),
        Quantity(id: "mobility.fording_depth_kit_m", category: Mobility, unit: "m", evidence: Secondary,
            param: Param(v: 1.524, prov: Spec, src: "UNVERIFIED(search summary, page not opened): 60 in with deep-water fording kit"),
            notes: ""),
        Quantity(id: "static.tyre_unloaded_radius_m", category: Static, unit: "m", evidence: Cross,
            param: Param(v: 0.4699, lo: Some(0.44), hi: Some(0.5), prov: Estimate, src: "Cross-check only: Project Chrono data/vehicle/hmmwv (raw.githubusercontent.com/projectchrono/chrono/main/data/vehicle/hmmwv/...), read in full, tire/HMMWV_TMeasyTire.json"),
            notes: "Never imported."),
        Quantity(id: "static.tyre_width_m", category: Static, unit: "m", evidence: Cross,
            param: Param(v: 0.3175, lo: Some(0.3), hi: Some(0.33), prov: Estimate, src: "Cross-check only: Project Chrono data/vehicle/hmmwv (raw.githubusercontent.com/projectchrono/chrono/main/data/vehicle/hmmwv/...), read in full, tire/HMMWV_TMeasyTire.json"),
            notes: ""),
        Quantity(id: "dynamics.min_turn_radius_m", category: Dynamics, unit: "m", evidence: Cross,
            param: Param(v: 7.62, lo: Some(7.0), hi: Some(8.5), prov: Estimate, src: "Cross-check only: Project Chrono data/vehicle/hmmwv (raw.githubusercontent.com/projectchrono/chrono/main/data/vehicle/hmmwv/...), read in full, vehicle/HMMWV_Vehicle.json"),
            notes: "A published figure is still needed."),
        Quantity(id: "static.chassis_sprung_mass_kg", category: Static, unit: "kg", evidence: Cross,
            param: Param(v: 2086.52, lo: Some(1900), hi: Some(2300), prov: Estimate, src: "Cross-check only: Project Chrono data/vehicle/hmmwv (raw.githubusercontent.com/projectchrono/chrono/main/data/vehicle/hmmwv/...), read in full, chassis/HMMWV_Chassis.json (sprung chassis, not curb)"),
            notes: ""),
    ],
)
