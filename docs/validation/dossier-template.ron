// Dossier template. One file per real vehicle: content/dossier/<id>.ron (lane VALIDATION owns the schema from here).
// Every quantity: id, category, unit, a Param (value, optional band lo/hi, provenance, source). Rules:
//  - Spec and Measured need a source (document title and page, or URL and access date); Estimate needs a band (lo and hi).
//  - Disagreeing sources are both recorded and the band covers them. Nothing from memory. A source you could not open is marked UNVERIFIED in notes.
//  - ids are stable: <category>.<name>_<unit-suffix>, e.g. static.mass_kg.
// The numbers below are placeholders (value 0.0) that show the shape; do not copy them.
Dossier(
    id: "example",
    name: "Example vehicle (template)",
    role: Calibration,               // Calibration or HeldOut (ADR-0007)
    era: "template",
    quantities: [
        Quantity(
            id: "static.mass_kg",
            category: Static,
            unit: "kg",
            param: Param(v: 0.0, lo: Some(0.0), hi: Some(0.0), prov: Spec, src: "Operator manual TM x-xxxx, p. N: combat weight"),
            notes: "Say which loading (curb, combat, max). Variants differ by hundreds of kg.",
        ),
        Quantity(
            id: "powertrain.top_speed_governed_m_s",
            category: Powertrain,
            unit: "m/s",
            param: Param(v: 0.0, lo: Some(0.0), hi: Some(0.0), prov: Measured, src: "Test report, Table N"),
            notes: "",
        ),
        Quantity(
            id: "static.com_height_m",
            category: Static,
            unit: "m",
            param: Param(v: 0.0, lo: Some(0.0), hi: Some(0.0), prov: Estimate, src: "Estimated from silhouette and component layout; band covers +-0.15 m"),
            notes: "Usually unpublished.",
        ),
    ],
)
